# Chemin relatif : le proxy Vite (/api) relaie vers http://localhost:3000.
# Une URL absolue est aussi acceptée (ex. https://api.hayat-sn.store/api).
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PATH=/socket.io
# Public origin of the storefront, sent as the landingPage of a marketing session.
VITE_SITE_URL=https://hayat-sn.store

# Social Auth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.your.app.bundle-id
# VITE_APPLE_REDIRECT_URI is no longer needed: the redirect_uri is built from VITE_API_URL (/auth/apple/callback)

# Server-only token from https://prerender.io (Settings > API Key).
# Used by middleware.ts to serve prerendered HTML to search engine crawlers.
# Set it in Vercel (Project Settings → Environment Variables), not in VITE_ vars.
PRERENDER_TOKEN=
